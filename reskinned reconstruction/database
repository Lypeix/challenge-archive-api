from pathlib import Path # Path represents filesystem location as an object. It exists to not have to manually construct paths with string

from sqlalchemy import create_engine, event # engine is a SQLAlchemy connector that knows which db system is used, where db is, how to get n manage db connections 
                                            # n which db driver should communicate with it
                                            # event allows to register functions that SQLalchemy runs when certain things happen 


from sqlalchemy.orm import DeclarativeBase, sessionmaker # In Base(DeclarativeBase), Base becomes the shared parent class for db models that then become
                                                         # recognized as ORM models
                                                         # sessionmaker creates a factory for db sessions (session manages current interaction between app n db)

DATABASE_PATH = (
    Path(__file__).resolve().parent.parent / "challange-archive.db" # After conversions in here the path becomes C:\projects\challenge-archive-api (project root)
                                                                    # then it describes that challenge-archivedb should be there
)

DATABASE_URL = f"sqlite:///{DATABASE_PATH.as_posix()}" # DATABASE_PATH.as_posix() transforms Path object into a string using forward slashes
                                                       # Then it adds the textual value into SQLAlchemy db URL


engine = create_engine(
    DATABASE_URL, # from this URL, engine learns to use SQLite dialect AND to use the db at this location
    connect_args={"check_same_thread": False} # by default it means connection may only be used by the same thread that made it 
)                                             # however this is set to false, therefore it can be accessed by other threads


@event.listens_for(engine, "connect")
def enable_sqlite_foreign_keys(
    dbapi_connection, # sqlite3 connection
    connection_record # required for the event cause it stores ORM's record for this connection, but its unused here
):

    cursor = dbapi_connection.cursor()
    cursor.execute("PRAGMA foreign_keys = ON") # Makes SQLite reject references to rows that don't exist
    cursor.close()
    